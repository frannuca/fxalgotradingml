{
    "pairs": ["EURUSD", "GBPUSD", "USDJPY"],

    "lookback": 90,
    "years": 20,
    "train_frac": 0.8,

    "weight_scheme": "softmax",
    "hidden_size": 64,
    "epochs": 150,
    "lr": 0.001,
    "dropout": 0.1,
    "weight_decay": 0.0001,
    "noise_std": 0.10,
    "target_vol": 0.05,

    "n_seeds": 5,
    "restart_strategy": "best",

    "risk_overlay": true,
    "risk_hidden_size": 64,
    "risk_epochs": 50,
    "risk_lr": 0.001,
    "max_attenuation": 0.33,
    "risk_rolling_window": 40,

    "load_portfolio": null,
    "load_risk": null,
    "save_db": true,
    "model_description": "long only model with risk overlay",

    "output": "results/portfolio_pnl.png",
    "position_output": "results/risk_position.png",
    "vol_matched_output": "results/risk_vol_matched_pnl.png"
}